# Required: Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: model id (default claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# News search for the comparable-verdict research (platform.parallel.ai)
PARALLEL_API_KEY=
# Optional but recommended: CourtListener token for higher rate limits (courtlistener.com profile)
COURTLISTENER_TOKEN=

# Shared storage for two-person disputes on The Bench.
# Add an Upstash Redis store from the Vercel Marketplace and these are filled in for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Spending guards
DAILY_AI_CAP=400
AI_PER_HOUR=40
RESEARCH_PER_HOUR=12
